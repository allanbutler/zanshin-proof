{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zanshin.dev/schemas/proof/report-v1.schema.json",
  "title": "Zanshin Proof Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "verdict", "policy_version", "provenance", "summary", "checks"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["pass", "warn", "fail"]},
    "policy_version": {"const": 1},
    "provenance": {"$ref": "evidence-v1.schema.json#/$defs/provenance"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "fail", "error"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "required", "message", "observed", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "warn", "fail", "error"]},
          "required": {"type": "boolean"},
          "message": {"type": "string"},
          "observed": true,
          "expected": true
        }
      }
    }
  }
}
